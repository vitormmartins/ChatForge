	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"const loginRequest = {",
					"  url: \"http://localhost:8080/auth/login\",",
					"  method: \"POST\",",
					"  header: {",
					"    \"Content-Type\": \"application/json\",",
					"    \"Authorization\": \"Basic YTpi\"",
					"  },",
					"  body: {",
					"    mode: \"raw\",",
					"    raw: JSON.stringify({",
					"      \"username\": \"Vítor Matosinho\",",
					"      \"password\": \"This is my first blog comment for testing.\"",
					"    })",
					"  }",
					"};",
					"",
					"pm.sendRequest(loginRequest, (error, response) => {",
					"  if (error) {",
					"    console.error(error);",
					"  } else {",
					"    const jwtToken = response.text(); // Get the response body as text",
					"    console.log(jwtToken); // Log the JWT token",
					"    pm.globals.set('jwtToken', jwtToken); // Set the JWT token as a Global Variable in Postman",
					"  }",
					"});"
				]
			}
